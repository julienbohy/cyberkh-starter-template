parameters:
    level: max
    paths:
        - bin/
        - config/
        - public/
        - src/
        - tests/
        - castor.php
        - .castor/
    # The API of Castor, generated by castor itself: castor.php runs in the Castor phar, not with vendor/.
    scanFiles:
        - .castor.stub.php
    excludePaths:
        # Generated by Symfony on each cache warmup.
        - config/reference.php
    ignoreErrors:
        # The validation constraints are attributes, but Symfony keeps them with their validators.
        -
            identifier: symplify.requireAttributeNamespace
            path: src/Validator/*
        # The hub of the test env, wired in config/services.yaml under when@test, which the dev
        # container read by PHPStan does not hold; its static API serves the tests.
        -
            identifier: shipmonk.deadMethod
            path: tests/RealTime/HubSpy.php
    symfony:
        containerXmlPath: var/cache/dev/App_KernelDevDebugContainer.xml
    doctrine:
        objectManagerLoader: tests/object-manager.php
