{% extends 'email/layout.html.twig' %}

{% block body %}
    <h1>{{ 'reset_password.email.heading'|trans }}</h1>

    <p>{{ 'reset_password.email.intro'|trans }}</p>

    {{ include('email/_button.html.twig', {href: url('app_reset_password', {token: resetToken.token}), label: 'reset_password.email.link'|trans}) }}

    <p class="note">{{ 'email.link_expires'|trans({'%delay%': resetToken.expirationMessageKey|trans(resetToken.expirationMessageData, 'ResetPasswordBundle')}) }}</p>

    <p class="note">{{ 'reset_password.email.ignore'|trans }}</p>
{% endblock %}
