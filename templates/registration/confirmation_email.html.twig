{% extends 'email/layout.html.twig' %}

{% block body %}
    <h1>{{ 'registration.email.heading'|trans }}</h1>

    <p>{{ 'registration.email.intro'|trans }}</p>

    {{ include('email/_button.html.twig', {href: signedUrl|raw, label: 'registration.email.link'|trans}) }}

    <p class="note">{{ 'email.link_expires'|trans({'%delay%': expiresAtMessageKey|trans(expiresAtMessageData, 'VerifyEmailBundle')}) }}</p>
{% endblock %}
